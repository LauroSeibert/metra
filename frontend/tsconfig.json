{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/app/shared/ui/helm/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/shared/ui/helm/utils/src/index.ts"],
      "@spartan-ng/helm/badge": ["./src/app/shared/ui/helm/badge/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/shared/ui/helm/input/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/app/shared/ui/helm/label/src/index.ts"],
      "@spartan-ng/helm/field": ["./src/app/shared/ui/helm/field/src/index.ts"],
      "@spartan-ng/helm/separator": ["./src/app/shared/ui/helm/separator/src/index.ts"],
      "@spartan-ng/helm/card": ["./src/app/shared/ui/helm/card/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/app/shared/ui/helm/switch/src/index.ts"],
      "@spartan-ng/helm/avatar": ["./src/app/shared/ui/helm/avatar/src/index.ts"],
      "@spartan-ng/helm/skeleton": ["./src/app/shared/ui/helm/skeleton/src/index.ts"],
      "@spartan-ng/helm/empty": ["./src/app/shared/ui/helm/empty/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
