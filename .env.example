# Copie para .env e troque as senhas. O .env nunca vai para o repositório.
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
API_PORT=5080
WEB_PORT=8080
# Primeiro Admin (criado só com a base sem usuários). Senha: 8+ caracteres, com maiúscula, minúscula e número.
ADMIN_EMAIL=admin@erp.local
ADMIN_PASSWORD=
# Opcional: cria operador@erp.local e leitura@erp.local com esta senha (só para testar os perfis).
DEMO_USERS_PASSWORD=
